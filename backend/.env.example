# Copy to backend/.env for local development. In production, ../.env is
# generated by install.sh and passed in by docker-compose.yml.
APP_NAME=Kin
ENVIRONMENT=development
LOG_LEVEL=INFO

# kin_api login: no BYPASSRLS, no table grants of its own (see 0002_rls.sql)
DATABASE_URL=postgresql://kin_api:apipass@localhost:55432/postgres
# Superuser: ONLY for `python -m app.db.migrate` and `python -m app.db.reembed`
DATABASE_ADMIN_URL=postgresql://supabase_admin:testpass@localhost:55432/postgres
KIN_API_DB_PASSWORD=apipass
KIN_WORKER_DB_PASSWORD=workerpass

REDIS_URL=redis://localhost:6379/0

# Supabase GoTrue
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
GOTRUE_URL=http://localhost:59999

# Models (IDs from env, never hardcoded in logic)
LLM_PROVIDER=anthropic          # anthropic | ollama | fake
LLM_MODEL=claude-opus-5-5
LLM_REFUSAL_FALLBACK=default    # default | off
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.2

EMBEDDING_PROVIDER=hashing      # openai | hashing | ollama | fake
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=

CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_ENABLED=true
